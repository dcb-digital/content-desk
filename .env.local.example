NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
ENCRYPTION_KEY=            # AES-GCM, 32 bytes hex (openssl rand -hex 32)
APP_URL=http://localhost:3000

# Workspace LLM keys are stored encrypted in DB; these are dev fallbacks
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
DEFAULT_LLM_PROVIDER=anthropic

# Batch drafting. Local dev: set INNGEST_DEV=1 and run `npx inngest-cli@latest dev`
# — the SDK otherwise assumes cloud mode and /api/inngest returns 500.
# Production: both keys are required. Without the signing key the SDK refuses to
# serve the endpoint, which is what keeps it safe behind the auth-exempt path.
INNGEST_DEV=1
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# v1.1
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
AHREFS_API_KEY=
